pipeline {
    agent {
        docker {
            image 'node:lts-buster-slim'
            args '-p 3000:3000'
        }
    }
    environment {
        CI = 'true'
        NODE_OPTIONS = '--openssl-legacy-provider'
        GITHUB_TOKEN = credentials('jenkins-github-token')
        GITHUB_REPOSITORY = 'jodyheryanto/a428-cicd-labs'
        PUBLIC_URL = 'https://jodyheryanto.github.io/a428-cicd-labs'
    }
    triggers {
        pollSCM('H/2 * * * *')
    }
    stages {
        stage('Setup') {
            steps {
                sh 'apt-get update && apt-get install -y git'
            }
        }
        stage('Clone Repository') {
            steps {
                git branch: 'react-app',
                    credentialsId: 'jenkins-github-token',
                    url: 'https://github.com/jodyheryanto/a428-cicd-labs.git'
            }
        }
        stage('Build') {
            steps {
                sh 'npm install'
            }
        }
        stage('Test') {
            steps {
                sh './jenkins/scripts/test.sh'
            }
        }
        stage('Manual Approval') {
            steps {
                input message: 'Lanjutkan ke tahap Deploy?', ok: 'Proceed'
            }
        }
        stage('Deploy') {
            steps {
                sh './jenkins/scripts/deliver.sh'
                echo 'Aplikasi berjalan selama 1 menit sebelum dihentikan...'
                sleep(time: 60, unit: 'SECONDS')
                sh './jenkins/scripts/kill.sh'
            }
        }
    }
}
